{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "OpenCode configuration (~/.config/opencode/opencode.json)",
  "_docs": "https://github.com/opencode-ai/opencode",

  "plugin": [
    "opencode-openai-codex-auth"
  ],

  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "store": false
      },
      "models": {
        "default-low": {
          "name": "Default Low Reasoning",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "low",
            "reasoningSummary": "auto",
            "textVerbosity": "medium",
            "store": false
          }
        },
        "default-medium": {
          "name": "Default Medium Reasoning",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "medium",
            "reasoningSummary": "auto",
            "textVerbosity": "medium",
            "store": false
          }
        },
        "default-high": {
          "name": "Default High Reasoning",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "textVerbosity": "medium",
            "store": false
          }
        }
      }
    },

    "anthropic": {
      "_comment": "Uncomment to add Anthropic as a provider",
      "_example_api_key_env": "ANTHROPIC_API_KEY",
      "models": {
        "claude-sonnet": {
          "name": "Claude Sonnet",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  }
}
